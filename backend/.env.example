# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/invoice_ai

# Server port
PORT=5000

# Anthropic API key (https://console.anthropic.com) - powers the AI invoice parser
ANTHROPIC_API_KEY=your_api_key_here

# Model to use for the AI features.
# Check https://docs.claude.com for the current list of available model names
# before deploying - model strings are updated over time.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Your business info, used on generated PDFs
BUSINESS_NAME=Your Company Name
BUSINESS_EMAIL=billing@yourcompany.com
